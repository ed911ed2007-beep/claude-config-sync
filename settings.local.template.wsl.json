{
  "_comment": "WSL Ubuntu 本機設定範本。使用時複製為 ~/.claude/settings.local.json 並將 <wsl_user> 替換為實際使用者名稱。",
  "env": {
    "CLAUDE_WORKLOG_PATH": "/home/<wsl_user>/Claude-workspace/daily-log/_session-ends.log"
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo \"[$(date '+%Y-%m-%d %H:%M')] Session active\" >> $CLAUDE_WORKLOG_PATH",
            "shell": "bash",
            "statusMessage": "記錄工作時間..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": []
  }
}
